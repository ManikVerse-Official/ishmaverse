@@ -0,0 +1,221 @@
+import { create } from 'zustand';
+import { FREE_USE_LIMIT, isAdminEmail, getPlanById } from '../config/plans';
+import {
+  consumeServerUse,
+  fetchServerEntitlement,
+  subscribeOnServer,
+} from '../services/entitlementApi';
+import { isSupabaseConfigured } from '../services/supabase';
+
+/**
+ * Entitlement: who is using ReportCard Studio, how many free generations they
+ * have left, and whether they hold an active subscription.
+ *
+ * NOTE: this is a client-side, local-first implementation so the whole flow can
+ * be tried and tested without any backend. It is intentionally isolated behind
+ * `canGenerate` / `consumeUse` so it can later be swapped for a Supabase-backed
+ * (server-enforced) source without touching the pages.
+ */
+
+export interface Account {
+  name: string;
+  email: string;
+}
+
+interface PersistedEntitlement {
+  account: Account | null;
+  freeUsesRemaining: number;
+  planId: string | null;
+  planStartedAt: string | null;
+  planExpiresAt: string | null;
+}
+
+const STORAGE_KEY = 'rcs:entitlement';
+
+const DEFAULT_STATE: PersistedEntitlement = {
+  account: null,
+  freeUsesRemaining: FREE_USE_LIMIT,
+  planId: null,
+  planStartedAt: null,
+  planExpiresAt: null,
+};
+
+function loadState(): PersistedEntitlement {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    if (!raw) return DEFAULT_STATE;
+    const parsed = JSON.parse(raw) as Partial<PersistedEntitlement>;
+    return {
+      ...DEFAULT_STATE,
+      ...parsed,
+      freeUsesRemaining:
+        typeof parsed.freeUsesRemaining === 'number'
+          ? Math.max(0, Math.min(FREE_USE_LIMIT, parsed.freeUsesRemaining))
+          : FREE_USE_LIMIT,
+    };
+  } catch {
+    return DEFAULT_STATE;
+  }
+}
+
+function persist(state: PersistedEntitlement): void {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
+  } catch {
+    /* ignore quota / private mode */
+  }
+}
+
+function addMonths(date: Date, months: number): Date {
+  const next = new Date(date.getTime());
+  next.setMonth(next.getMonth() + months);
+  return next;
+}
+
+export interface EntitlementState extends PersistedEntitlement {
+  isAdmin: boolean;
+  planActive: boolean;
+  planId: string | null;
+  planExpiresAt: string | null;
+
+  signIn: (name: string, email: string) => void;
+  signOut: () => void;
+  activatePlan: (planId: string) => void;
+  consumeUse: () => void;
+  canGenerate: () => { allowed: boolean; isFree: boolean; reason?: string };
+  /** Pulls the authoritative plan + free uses from the server (no-op offline). */
+  refreshFromServer: () => Promise<void>;
+}
+
+const initial = loadState();
+
+export const useEntitlement = create<EntitlementState>((set, get) => {
+  const computeActive = (s: PersistedEntitlement): boolean => {
+    if (!s.planId || !s.planExpiresAt) return false;
+    return new Date(s.planExpiresAt).getTime() > Date.now();
+  };
+
+  return {
+    ...initial,
+    isAdmin: initial.account ? isAdminEmail(initial.account.email) : false,
+    planActive: computeActive(initial),
+
+    signIn: (name, email) =>
+      set(() => {
+        const account = { name: name.trim(), email: email.trim() };
+        const next: PersistedEntitlement = { ...get(), account };
+        persist(next);
+        return { ...next, isAdmin: isAdminEmail(account.email) };
+      }),
+
+    signOut: () =>
+      set(() => {
+        const next: PersistedEntitlement = { ...get(), account: null };
+        persist(next);
+        return { ...next, isAdmin: false };
+      }),
+
+    activatePlan: (planId) => {
+      const plan = getPlanById(planId);
+      const now = new Date();
+      const expires = addMonths(now, plan?.durationMonths ?? 6);
+      const current = get();
+      const next: PersistedEntitlement = {
+        ...current,
+        planId,
+        planStartedAt: now.toISOString(),
+        planExpiresAt: expires.toISOString(),
+      };
+      persist(next);
+      set({ ...next, planActive: true });
+
+      // Record the subscription server-side (which also sends the bill email).
+      const email = next.account?.email;
+      if (email && isSupabaseConfigured()) {
+        void subscribeOnServer(email, planId, next.account?.name).then((server) => {
+          if (server?.expiresAt) {
+            set((s) => {
+              const merged: PersistedEntitlement = {
+                ...s,
+                planId: server.planId ?? s.planId,
+                planExpiresAt: server.expiresAt,
+              };
+              persist(merged);
+              return { ...merged, planActive: true };
+            });
+          }
+        });
+      }
+    },
+
+    consumeUse: () => {
+      const state = get();
+      const paidActive =
+        Boolean(state.planId) &&
+        Boolean(state.planExpiresAt) &&
+        new Date(state.planExpiresAt as string).getTime() > Date.now();
+
+      if (!state.isAdmin && !paidActive) {
+        const next: PersistedEntitlement = {
+          ...state,
+          freeUsesRemaining: Math.max(0, state.freeUsesRemaining - 1),
+        };
+        persist(next);
+        set(next);
+      }
+
+      // Keep the server counter in step (best-effort; never blocks generation).
+      const email = state.account?.email;
+      if (email && isSupabaseConfigured()) {
+        void consumeServerUse(email, 'studio_generation').then((result) => {
+          if (result && typeof result.remaining === 'number') {
+            set((s) => {
+              const merged: PersistedEntitlement = {
+                ...s,
+                freeUsesRemaining: Math.min(FREE_USE_LIMIT, Math.max(0, result.remaining)),
+              };
+              persist(merged);
+              return merged;
+            });
+          }
+        });
+      }
+    },
+
+    refreshFromServer: async () => {
+      const email = get().account?.email;
+      if (!email || !isSupabaseConfigured()) return;
+      const server = await fetchServerEntitlement(email);
+      if (!server) return;
+      set((s) => {
+        const merged: PersistedEntitlement = {
+          ...s,
+          freeUsesRemaining: server.planActive ? s.freeUsesRemaining : Math.min(FREE_USE_LIMIT, Math.max(0, server.freeRemaining)),
+          planId: server.planActive ? server.planId : s.planId,
+          planExpiresAt: server.planActive ? server.expiresAt : s.planExpiresAt,
+        };
+        persist(merged);
+        return {
+          ...merged,
+          planActive: server.planActive || s.planActive,
+        };
+      });
+    },
+
+    canGenerate: () => {
+      const state = get();
+      if (state.isAdmin) return { allowed: true, isFree: true };
+      const paidActive =
+        Boolean(state.planId) &&
+        Boolean(state.planExpiresAt) &&
+        new Date(state.planExpiresAt as string).getTime() > Date.now();
+      if (paidActive) return { allowed: true, isFree: false };
+      if (state.freeUsesRemaining > 0) return { allowed: true, isFree: true };
+      return {
+        allowed: false,
+        isFree: false,
+        reason: 'Your 5 free report-card generations are used up. Subscribe to keep generating.',
+      };
+    },
+  };
+});
