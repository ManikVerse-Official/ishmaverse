+  const affiliationLine = [
+    header.affiliationText,
+    header.schoolCode ? `SCHOOL CODE: ${header.schoolCode}` : '',
+    header.affiliationNo ? `AFFILIATION NO.: ${header.affiliationNo}` : '',
+  ]
+    .filter(Boolean)
