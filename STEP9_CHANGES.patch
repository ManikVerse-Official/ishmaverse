+type Density = 'normal' | 'compact' | 'ultra';
+
+interface DensityTokens {
+  titleBar: string;
+  sectionGap: string;
+  sectionTitle: string;
+  acadFont: string;
+  acadPad: string;
+  acadHeadPad: string;
+  coFont: string;
