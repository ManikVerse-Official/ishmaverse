+
+            <div className="flex-1 min-w-0 text-center">
+              <h1 className="text-[22px] leading-tight font-extrabold tracking-wide uppercase text-white rc-wrap">
+                {header.schoolName}
+              </h1>
+              {header.address && (
+                <p className="text-[10px] mt-0.5 rc-wrap" style={{ color: '#e0e7ff' }}>
+                  {header.address}
+                </p>
