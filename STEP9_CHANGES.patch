+import { useState } from 'react';
+import { useNavigate, useSearchParams, Link } from 'react-router-dom';
+import { LogIn, ShieldCheck, ArrowRight } from 'lucide-react';
+import clsx from 'clsx';
+import { STUDIO_PLANS, getPlanById } from '../config/plans';
+import { useEntitlement } from '../store/entitlementStore';
+
+/**
+ * Sign in (name + email) and subscribe to a plan. With Supabase connected this
+ * submits the subscription to the Ishmaverse checkout; until then it activates
+ * the plan locally so the whole flow can be tested end to end.
+ */
+export default function Login() {
+  const navigate = useNavigate();
+  const [params] = useSearchParams();
+  const { signIn, activatePlan, account, planActive, planId, signOut } = useEntitlement();
+
+  const initialPlan = getPlanById(params.get('plan'))?.id ?? STUDIO_PLANS[2].id;
+  const [selectedPlan, setSelectedPlan] = useState(initialPlan);
+  const [name, setName] = useState(account?.name ?? '');
+  const [email, setEmail] = useState(account?.email ?? '');
+  const [error, setError] = useState('');
+  const [done, setDone] = useState(false);
+
+  const plan = getPlanById(selectedPlan)!;
+
+  const submit = (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!name.trim()) {
+      setError('Please enter your name.');
+      return;
+    }
+    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
+      setError('Please enter a valid email address.');
+      return;
+    }
+    setError('');
+    signIn(name, email);
+    activatePlan(selectedPlan);
+    setDone(true);
+  };
+
+  if (done) {
+    return (
+      <div className="max-w-lg mx-auto card mt-6">
+        <div className="card-body text-center space-y-3">
+          <div className="h-14 w-14 mx-auto rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
+            <ShieldCheck className="h-7 w-7" />
+          </div>
+          <h2 className="text-xl font-semibold text-ink-900">You're subscribed! 🎉</h2>
+          <p className="text-sm text-ink-600">
+            The <strong>{plan.name}</strong> plan is active for {plan.durationMonths} months. A
+            confirmation email with your receipt will be sent to <strong>{email}</strong>.
+          </p>
+          <div className="flex flex-col sm:flex-row gap-3 pt-2">
+            <button
+              onClick={() => navigate('/generate')}
+              className="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-brand-600 text-white font-semibold hover:bg-brand-700"
+            >
+              Start generating <ArrowRight className="h-4 w-4" />
+            </button>
+            <button
+              onClick={() => navigate('/dashboard')}
+              className="flex-1 px-5 py-3 rounded-xl border border-slate-300 text-ink-700 font-semibold hover:bg-slate-50"
+            >
+              Go to dashboard
+            </button>
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-lg mx-auto mt-6 space-y-4">
+      {account && (
+        <div className="card">
+          <div className="card-body flex items-center justify-between gap-3 text-sm">
+            <span className="text-ink-700">
+              Signed in as <strong>{account.email}</strong>
+              {planActive && planId ? ' · plan active' : ''}
+            </span>
+            <button
+              onClick={signOut}
+              className="text-xs font-semibold text-red-600 hover:underline shrink-0"
+            >
+              Sign out
+            </button>
+          </div>
+        </div>
+      )}
+
+      <form onSubmit={submit} className="card">
+        <div className="card-header flex items-center gap-2">
+          <LogIn className="h-5 w-5 text-brand-600" />
+          <h2 className="text-lg font-semibold text-ink-900">Sign in &amp; subscribe</h2>
+        </div>
+        <div className="card-body space-y-4">
+          <div>
+            <label className="label" htmlFor="login-name">
+              Your name *
+            </label>
+            <input
+              id="login-name"
+              className="input"
+              value={name}
+              onChange={(e) => setName(e.target.value)}
+              placeholder="e.g. Priya Sharma"
+              autoComplete="name"
+            />
+          </div>
+          <div>
+            <label className="label" htmlFor="login-email">
+              Email *
+            </label>
+            <input
+              id="login-email"
+              className="input"
+              type="email"
+              value={email}
+              onChange={(e) => setEmail(e.target.value)}
+              placeholder="you@school.com"
+              autoComplete="email"
+            />
+            <p className="text-xs text-ink-500 mt-1">
+              Your receipt and welcome email will be sent here.
+            </p>
+          </div>
+
+          <div>
+            <span className="label">Choose your plan</span>
+            <div className="space-y-2">
+              {STUDIO_PLANS.map((p) => (
+                <button
+                  type="button"
+                  key={p.id}
+                  onClick={() => setSelectedPlan(p.id)}
+                  className={clsx(
+                    'w-full flex items-center justify-between gap-3 rounded-xl border px-4 py-3 text-left transition-colors',
+                    selectedPlan === p.id
+                      ? 'border-brand-500 bg-brand-50'
+                      : 'border-slate-200 hover:border-slate-300',
+                  )}
+                >
+                  <span className="min-w-0">
+                    <span className="block font-semibold text-ink-900">{p.name}</span>
+                    <span className="block text-xs text-ink-500">{p.tagline}</span>
+                  </span>
+                  <span className="text-right shrink-0">
+                    <span className="block font-bold text-ink-900">₹{p.priceInr}</span>
+                    <span className="block text-[11px] text-ink-500">${p.priceUsd} · {p.durationMonths} mo</span>
+                  </span>
+                </button>
+              ))}
+            </div>
+          </div>
+
+          {error && (
+            <p className="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2">
+              {error}
+            </p>
+          )}
+
+          <button
+            type="submit"
+            className="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-brand-600 text-white font-semibold hover:bg-brand-700"
+          >
+            Continue to payment · ₹{plan.priceInr}
+            <ArrowRight className="h-4 w-4" />
+          </button>
+
+          <p className="text-[11px] text-ink-500 text-center">
+            New here? You can try 5 report cards for free first — no account needed.{' '}
+            <Link to="/generate" className="text-brand-700 hover:underline">
+              Start free
+            </Link>
+          </p>
+        </div>
+      </form>
+    </div>
+  );
+}
